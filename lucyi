<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>✨ Lucyi's Violet Paradise ✨</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Comic Sans MS', 'Arial Rounded MT Bold', cursive, sans-serif;
            background: linear-gradient(135deg, #ffeef8 0%, #e6ccff 50%, #d4c5ff 100%);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 900px;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
            animation: bounce 2s infinite;
        }

        .title {
            font-size: 3em;
            color: #d946a6;
            text-shadow: 3px 3px 0 rgba(255, 255, 255, 0.8), 6px 6px 0 rgba(214, 70, 166, 0.3);
            margin-bottom: 10px;
            font-weight: bold;
        }

        .subtitle {
            font-size: 1.3em;
            color: #a64d9a;
            font-style: italic;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .floating {
            display: inline-block;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            border-radius: 30px;
            padding: 25px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(214, 70, 166, 0.2);
            cursor: pointer;
            transition: all 0.3s;
            border: 4px solid transparent;
        }

        .card:hover {
            transform: translateY(-10px) scale(1.05);
            box-shadow: 0 20px 50px rgba(214, 70, 166, 0.4);
            border-color: #d946a6;
        }

        .card-emoji {
            font-size: 80px;
            margin-bottom: 15px;
            animation: spin 4s linear infinite;
        }

        .card:nth-child(2) .card-emoji {
            animation: bounce 1.5s ease-in-out infinite;
        }

        .card:nth-child(3) .card-emoji {
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.2); }
        }

        .card-title {
            font-size: 1.4em;
            color: #d946a6;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .card-description {
            color: #a64d9a;
            font-size: 0.95em;
            line-height: 1.5;
        }

        .section {
            background: white;
            border-radius: 30px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(214, 70, 166, 0.15);
            border: 3px dashed #d946a6;
        }

        .section h2 {
            color: #d946a6;
            font-size: 2em;
            margin-bottom: 20px;
            text-align: center;
        }

        .button {
            background: linear-gradient(135deg, #d946a6 0%, #a64d9a 100%);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 20px;
            font-size: 1.1em;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
            border: 3px solid white;
            box-shadow: 0 5px 15px rgba(214, 70, 166, 0.4);
            font-family: 'Comic Sans MS', cursive;
        }

        .button:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(214, 70, 166, 0.6);
        }

        .button:active {
            transform: translateY(-1px);
        }

        .activity-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .activity {
            background: linear-gradient(135deg, #ffe6f3 0%, #f0e6ff 100%);
            padding: 15px;
            border-radius: 20px;
            text-align: center;
            border: 3px solid #d946a6;
            cursor: pointer;
            transition: all 0.3s;
        }

        .activity:hover {
            transform: scale(1.1) rotate(5deg);
            box-shadow: 0 10px 25px rgba(214, 70, 166, 0.3);
        }

        .activity-emoji {
            font-size: 50px;
            margin-bottom: 10px;
        }

        .activity-name {
            color: #d946a6;
            font-weight: bold;
            font-size: 1em;
        }

        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .gallery-item {
            background: white;
            border-radius: 20px;
            padding: 15px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(214, 70, 166, 0.2);
            border: 3px solid #e088d9;
            transition: all 0.3s;
        }

        .gallery-item:hover {
            transform: rotate(-5deg) translateY(-5px);
            border-color: #d946a6;
        }

        .gallery-emoji {
            font-size: 60px;
            margin-bottom: 10px;
        }

        .gallery-name {
            color: #a64d9a;
            font-weight: bold;
            font-size: 0.9em;
        }

        .love-section {
            background: linear-gradient(135deg, #ffe6f3 0%, #fff0f7 100%);
            border-radius: 30px;
            padding: 30px;
            text-align: center;
            margin-bottom: 30px;
            border: 4px solid #d946a6;
        }

        .love-text {
            font-size: 1.5em;
            color: #d946a6;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .heart-animation {
            display: inline-block;
            font-size: 2em;
            animation: heartBeat 0.6s ease-in-out infinite;
        }

        @keyframes heartBeat {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.3); }
        }

        .footer {
            text-align: center;
            color: #a64d9a;
            font-size: 1.1em;
            padding: 20px;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 20px;
            margin-bottom: 20px;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 20px;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: white;
            border-radius: 30px;
            padding: 40px;
            max-width: 500px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            border: 4px solid #d946a6;
            animation: popIn 0.3s ease-out;
        }

        @keyframes popIn {
            0% {
                transform: scale(0.8);
                opacity: 0;
            }
            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .modal-emoji {
            font-size: 80px;
            margin-bottom: 20px;
        }

        .modal-title {
            font-size: 2em;
            color: #d946a6;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .modal-text {
            color: #a64d9a;
            font-size: 1.1em;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .modal-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        @media (max-width: 600px) {
            .title {
                font-size: 2em;
            }
            .grid {
                grid-template-columns: 1fr;
            }
            .section {
                padding: 20px;
            }
        }

        .star {
            display: inline-block;
            font-size: 1.2em;
            margin: 0 5px;
        }

        .falling-hearts {
            position: fixed;
            pointer-events: none;
        }

        .confetti {
            position: fixed;
            pointer-events: none;
            animation: fall 3s linear forwards;
        }

        @keyframes fall {
            to {
                transform: translateY(100vh) rotate(360deg);
                opacity: 0;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header>
            <div class="title">✨ Lucyi's Violet Paradise ✨</div>
            <div class="subtitle">Un monde mignon rien que pour toi! 💜</div>
        </header>

        <!-- Section d'accueil mignon -->
        <div class="love-section">
            <div class="love-text">
                💜 Salut Lucyi! <span class="heart-animation">💜</span> C'est ton site spécial! 💜
            </div>
            <p style="color: #a64d9a; font-size: 1.1em;">Bienvenue dans ton univers violet magique!</p>
        </div>

        <!-- Sections interactives -->
        <div class="grid">
            <div class="card" onclick="showModal('gallery')">
                <div class="card-emoji floating">🦋</div>
                <div class="card-title">Galerie</div>
                <div class="card-description">Vois les créatures mignonnes!</div>
            </div>

            <div class="card" onclick="showModal('games')">
                <div class="card-emoji floating">🎮</div>
                <div class="card-title">Mini-Jeux</div>
                <div class="card-description">Joue à des petits jeux mignons!</div>
            </div>

            <div class="card" onclick="showModal('messages')">
                <div class="card-emoji floating">💌</div>
                <div class="card-title">Messages</div>
                <div class="card-description">Des messages spéciaux pour toi!</div>
            </div>
        </div>

        <!-- Galerie de créatures -->
        <div class="section">
            <h2>👾 Les Créatures Mignonnes</h2>
            <div class="gallery">
                <div class="gallery-item" onclick="celebrateCreature('Glim')">
                    <div class="gallery-emoji">✨</div>
                    <div class="gallery-name">Glim</div>
                </div>
                <div class="gallery-item" onclick="celebrateCreature('Bloom')">
                    <div class="gallery-emoji">🌸</div>
                    <div class="gallery-name">Bloom</div>
                </div>
                <div class="gallery-item" onclick="celebrateCreature('Zephyr')">
                    <div class="gallery-emoji">💨</div>
                    <div class="gallery-name">Zephyr</div>
                </div>
                <div class="gallery-item" onclick="celebrateCreature('Nova')">
                    <div class="gallery-emoji">⭐</div>
                    <div class="gallery-name">Nova</div>
                </div>
                <div class="gallery-item" onclick="celebrateCreature('Orion')">
                    <div class="gallery-emoji">🌙</div>
                    <div class="gallery-name">Orion</div>
                </div>
                <div class="gallery-item" onclick="celebrateCreature('Echo')">
                    <div class="gallery-emoji">🔮</div>
                    <div class="gallery-name">Echo</div>
                </div>
            </div>
        </div>

        <!-- Activités mignonnes -->
        <div class="section">
            <h2>🎨 Activités Amusantes</h2>
            <div class="activity-grid">
                <div class="activity" onclick="playPaint()">
                    <div class="activity-emoji">🎨</div>
                    <div class="activity-name">Dessiner</div>
                </div>
                <div class="activity" onclick="playClicker()">
                    <div class="activity-emoji">🖱️</div>
                    <div class="activity-name">Clicker</div>
                </div>
                <div class="activity" onclick="playSoap()">
                    <div class="activity-emoji">🫧</div>
                    <div class="activity-name">Bulles</div>
                </div>
                <div class="activity" onclick="playMemory()">
                    <div class="activity-emoji">🧠</div>
                    <div class="activity-name">Mémoire</div>
                </div>
                <div class="activity" onclick="playDancingCreatures()">
                    <div class="activity-emoji">💃</div>
                    <div class="activity-name">Danse</div>
                </div>
                <div class="activity" onclick="playSoundboard()">
                    <div class="activity-emoji">🔊</div>
                    <div class="activity-name">Bruitages</div>
                </div>
            </div>
        </div>

        <!-- Section spéciale -->
        <div class="section" style="background: linear-gradient(135deg, #ffe6f3 0%, #fff0f7 100%); border-color: #e088d9;">
            <h2 style="color: #d946a6;">💌 Un Message Spécial</h2>
            <p style="color: #a64d9a; font-size: 1.15em; line-height: 1.8; margin-top: 20px;">
                Lucyi, ce site a été créé spécialement pour toi! 💜<br>
                J'ai voulu te faire un endroit rempli de choses mignonnes et amusantes.<br>
                Tu es un homme formidable et tu mérites un site tout aussi spécial! ✨<br>
                <br>
                <strong>Amuse-toi bien et profite de chaque moment magique! 🌟</strong>
            </p>
            <button class="button" onclick="sendLove()" style="margin-top: 20px;">💜 Envoyer de l'Amour 💜</button>
        </div>

        <!-- Footer -->
        <div class="footer">
            <span class="star">✨</span>
            Créé avec 💜 pour Lucyi
            <span class="star">✨</span>
            <br>
            <span style="font-size: 2em; margin-top: 10px; display: block;">💜💜💜</span>
        </div>
    </div>

    <!-- Modals -->
    <div id="galleryModal" class="modal">
        <div class="modal-content">
            <div class="modal-emoji">🦋</div>
            <div class="modal-title">Galerie Mignonne!</div>
            <div class="modal-text">
                Clique sur une créature pour célébrer avec elle! Chacune a sa propre magie! ✨
            </div>
            <button class="button" onclick="closeModal()">Fermer</button>
        </div>
    </div>

    <div id="gamesModal" class="modal">
        <div class="modal-content">
            <div class="modal-emoji">🎮</div>
            <div class="modal-title">Mini-Jeux Mignons!</div>
            <div class="modal-text">
                Essaie les activités amusantes dans la section activités! Il y a plein de trucs sympas! 🎨🫧💃
            </div>
            <button class="button" onclick="closeModal()">Fermer</button>
        </div>
    </div>

    <div id="messagesModal" class="modal">
        <div class="modal-content">
            <div class="modal-emoji">💌</div>
            <div class="modal-title">Messages Spéciaux!</div>
            <div class="modal-text">
                Tu es incroyable! 💜
                <br><br>
                Merci de ton amitié et de ta bienveillance. 
                Tu fais une grosse différence pour les gens autour de toi.
                <br><br>
                Continue à être toi-même! ✨
            </div>
            <button class="button" onclick="closeModal()">Merci! 💜</button>
        </div>
    </div>

    <div id="celebrateModal" class="modal">
        <div class="modal-content">
            <div class="modal-emoji" id="celebrateEmoji">✨</div>
            <div class="modal-title" id="celebrateName">Glim!</div>
            <div class="modal-text" id="celebrateText">
                C'est une créature trop mignonne! 💜
            </div>
            <div class="modal-buttons">
                <button class="button" onclick="makeConfetti()">🎉 Fête!</button>
                <button class="button" onclick="closeModal()">Fermer</button>
            </div>
        </div>
    </div>

    <script>
        function showModal(type) {
            if (type === 'gallery') {
                document.getElementById('galleryModal').classList.add('active');
            } else if (type === 'games') {
                document.getElementById('gamesModal').classList.add('active');
            } else if (type === 'messages') {
                document.getElementById('messagesModal').classList.add('active');
            }
        }

        function closeModal() {
            document.querySelectorAll('.modal').forEach(m => m.classList.remove('active'));
        }

        function celebrateCreature(name) {
            const emojis = {
                'Glim': '✨',
                'Bloom': '🌸',
                'Zephyr': '💨',
                'Nova': '⭐',
                'Orion': '🌙',
                'Echo': '🔮'
            };
            
            document.getElementById('celebrateEmoji').textContent = emojis[name];
            document.getElementById('celebrateName').textContent = name + '!';
            document.getElementById('celebrateText').textContent = `${name} est trop mignonne! Elle t'envoie plein d'amour! 💜`;
            document.getElementById('celebrateModal').classList.add('active');
        }

        function makeConfetti() {
            const emojis = ['💜', '✨', '🦋', '🌸', '⭐', '🎀', '💖', '🌟'];
            for (let i = 0; i < 30; i++) {
                setTimeout(() => {
                    const confetti = document.createElement('div');
                    confetti.classList.add('confetti');
                    confetti.textContent = emojis[Math.floor(Math.random() * emojis.length)];
                    confetti.style.left = Math.random() * 100 + '%';
                    confetti.style.top = '-20px';
                    confetti.style.fontSize = (20 + Math.random() * 20) + 'px';
                    confetti.style.opacity = Math.random() * 0.5 + 0.5;
                    document.body.appendChild(confetti);
                    
                    setTimeout(() => confetti.remove(), 3000);
                }, i * 30);
            }
        }

        function sendLove() {
            makeConfetti();
            alert('💜 Beaucoup d\'amour envoyé! 💜\n\nTu es spécial! ✨');
        }

        function playPaint() {
            alert('🎨 Mode Dessin! (Peut être amélioré avec un vrai canvas)\nPour l\'instant, essaie une autre activité! 😊');
        }

        function playClicker() {
            let clicks = 0;
            const btn = document.createElement('button');
            btn.className = 'button';
            btn.style.fontSize = '2em';
            btn.textContent = '💜 (Clics: 0)';
            btn.onclick = () => {
                clicks++;
                btn.textContent = `💜 (Clics: ${clicks})`;
                if (clicks % 10 === 0) {
                    alert(`🎉 ${clicks} clics! Tu es super! 💪`);
                }
            };
            
            const modal = document.createElement('div');
            modal.className = 'modal active';
            modal.style.zIndex = '2000';
            modal.innerHTML = `
                <div class="modal-content">
                    <div class="modal-emoji">🖱️</div>
                    <div class="modal-title">Clicker Game!</div>
                    <div class="modal-text">Clique autant que tu veux! 💜</div>
                    <div id="clickerBtn"></div>
                    <button class="button" onclick="this.parentElement.parentElement.remove();" style="margin-top: 20px;">Fermer</button>
                </div>
            `;
            document.body.appendChild(modal);
            modal.querySelector('#clickerBtn').appendChild(btn);
        }

        function playSoap() {
            let bubbles = 0;
            const modal = document.createElement('div');
            modal.className = 'modal active';
            modal.style.zIndex = '2000';
            modal.innerHTML = `
                <div class="modal-content">
                    <div class="modal-emoji">🫧</div>
                    <div class="modal-title">Bulles Mignonnes!</div>
                    <div class="modal-text">Clique pour créer des bulles!</div>
                    <div id="bubbleContainer" style="height: 200px; background: linear-gradient(135deg, #ffe6f3 0%, #f0e6ff 100%); border-radius: 20px; margin: 20px 0; overflow: hidden; position: relative;"></div>
                    <button class="button" onclick="this.parentElement.parentElement.remove();">Fermer</button>
                </div>
            `;
            document.body.appendChild(modal);
            
            const container = modal.querySelector('#bubbleContainer');
            container.onclick = (e) => {
                const bubble = document.createElement('div');
                bubble.textContent = '🫧';
                bubble.style.position = 'absolute';
                bubble.style.left = e.offsetX + 'px';
                bubble.style.top = e.offsetY + 'px';
                bubble.style.fontSize = '30px';
                bubble.style.animation = 'fall 2s linear forwards';
                container.appendChild(bubble);
                setTimeout(() => bubble.remove(), 2000);
            };
        }

        function playMemory() {
            const emojis = ['💜', '🦋', '✨', '🌸', '💜', '🦋', '✨', '🌸'];
            const shuffled = emojis.sort(() => Math.random() - 0.5);
            let flipped = [];
            let matched = 0;
            
            const modal = document.createElement('div');
            modal.className = 'modal active';
            modal.style.zIndex = '2000';
            
            let html = `
                <div class="modal-content">
                    <div class="modal-emoji">🧠</div>
                    <div class="modal-title">Jeu de Mémoire!</div>
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 20px 0;">
            `;
            
            shuffled.forEach((emoji, i) => {
                html += `<button class="button" style="padding: 10px; font-size: 1.5em;" onclick="flipCard(${i})" id="card${i}">?</button>`;
            });
            
            html += `</div><button class="button" onclick="this.parentElement.parentElement.remove();">Fermer</button></div>`;
            modal.innerHTML = html;
            document.body.appendChild(modal);
            
            window.flipCard = (i) => {
                const card = modal.querySelector(`#card${i}`);
                card.textContent = shuffled[i];
                card.disabled = true;
            };
        }

        function playDancingCreatures() {
            const modal = document.createElement('div');
            modal.className = 'modal active';
            modal.style.zIndex = '2000';
            modal.innerHTML = `
                <div class="modal-content">
                    <div class="modal-emoji" style="animation: spin 1s linear infinite;">💃</div>
                    <div class="modal-title">Danse Mignonne!</div>
                    <div style="font-size: 3em; margin: 20px 0;">
                        <span style="animation: spin 1s linear infinite;">✨</span>
                        <span style="animation: bounce 1s ease-in-out infinite;">🦋</span>
                        <span style="animation: pulse 2s ease-in-out infinite;">🌸</span>
                    </div>
                    <p style="color: #a64d9a; font-size: 1.1em;">Les créatures dansent pour toi! 💜</p>
                    <button class="button" onclick="this.parentElement.parentElement.remove();">Fermer</button>
                </div>
            `;
            document.body.appendChild(modal);
        }

        function playSoundboard() {
            const sounds = [
                { name: '💜', sound: '💜' },
                { name: '✨', sound: '✨' },
                { name: '🦋', sound: '🦋' },
            ];
            
            const modal = document.createElement('div');
            modal.className = 'modal active';
            modal.style.zIndex = '2000';
            modal.innerHTML = `
                <div class="modal-content">
                    <div class="modal-emoji">🔊</div>
                    <div class="modal-title">Tableau de Sons!</div>
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 20px 0;">
            `;
            
            sounds.forEach(s => {
                modal.innerHTML += `<button class="button" style="font-size: 2em;" onclick="alert('${s.sound} Ding! 🔊')">${s.sound}</button>`;
            });
            
            modal.innerHTML += `</div><button class="button" onclick="this.parentElement.parentElement.remove();">Fermer</button></div>`;
            document.body.appendChild(modal);
        }

        // Fermer modals en cliquant en dehors
        document.addEventListener('click', (e) => {
            if (e.target.classList.contains('modal')) {
                closeModal();
            }
        });
    </script>
</body>
</html>
